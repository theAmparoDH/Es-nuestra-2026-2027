s [...]»."},{"id":253,"q":"La presidencia de la Comisión Mixta de la DA 9ª corresponde a: (DA 9ª)","opts":["La persona titular de la conselleria competente en servicios sociales, o persona en quien delegue","La alcaldía de la entidad local","La diputación provincial","La Federación Valenciana de Municipios y Provincias"],"correct":0,"just":"DA 9ª.4.a): «Presidencia: La persona titular de la Conselleria con competencias en materia de servicios sociales, o persona en quien delegue»."},{"id":227,"q":"La DA 4ª lleva por título: (DA 4ª)","opts":["Simultaneidad de la zona básica y del área de servicios sociales","Representación de mancomunidades","Subrogación en los contratos","Protección de datos"],"correct":0,"just":"Rúbrica: «Disposición adicional cuarta. Simultaneidad de la zona básica y del área de servicios sociales»."},{"id":251,"q":"La Comisión Mixta creada por la DA 9ª tiene por objeto: (DA 9ª)","opts":["La transferencia de personal, infraestructuras y equipamientos de competencia de la Generalitat","La valoración de prestaciones económicas","La aprobación de los contratos programa","La coordinación de la atención sanitaria"],"correct":0,"just":"DA 9ª.1: «Se crea la Comisión Mixta para la transferencia de personal, infraestructuras y equipamientos de competencia de la Generalitat en el Sistema Público Valenciano de Servicios Sociales»."}]}],"label_full":"Disposiciones adicionales"}]};
const cfg={penalty:false,timer:false,justif:true};
function toggleSetting(k){cfg[k]=!cfg[k];document.getElementById('tog-'+k).classList.toggle('on',cfg[k]);if(k==='timer'){if(!cfg.timer)stopTimer();updateTimerDisplay(60);}}
function openSettings(){document.getElementById('modal-overlay').classList.add('show')}
function closeSettings(){document.getElementById('modal-overlay').classList.remove('show')}
function toggleSidebar(){document.getElementById('sidebar').classList.toggle('open');document.getElementById('sidebar-overlay').classList.toggle('show')}
function closeSidebar(){document.getElementById('sidebar').classList.remove('open');document.getElementById('sidebar-overlay').classList.remove('show')}

function buildSidebar(){
  const list=document.getElementById('titulo-list');list.innerHTML='';
  RAW.grupos.forEach((g,gi)=>{
    const totalQ=g.arts.reduce((s,a)=>s+a.questions.length,0);
    const ti=document.createElement('div');ti.className='titulo-item';ti.dataset.gi=gi;
    ti.innerHTML=`<span style="flex:1">${g.label_full||g.label}</span><span class="titulo-badge">${totalQ}</span>`;
    ti.onclick=()=>{ti.classList.toggle('open');document.querySelectorAll('.titulo-item').forEach(x=>{if(x!==ti)x.classList.remove('open','active')});if(ti.classList.contains('open'))ti.classList.add('active')};
    list.appendChild(ti);
    const al=document.createElement('div');al.className='art-list';
    const allBtn=document.createElement('div');allBtn.className='art-item';allBtn.style.fontWeight='700';allBtn.style.color='var(--accent)';
    allBtn.innerHTML=`<span>▶ Todo el título</span><span class="art-dot"></span>`;
    allBtn.onclick=()=>{startGrupo(gi);closeSidebar()};al.appendChild(allBtn);
    g.arts.forEach((a,ai)=>{
      const label=a.art?`Art. ${a.art}`:'Estructura';
      const item=document.createElement('div');
      item.className='art-item'+(isMastered(g.key,a.art)?' mastered':'');item.id=`art-${gi}-${ai}`;
      item.innerHTML=`<span>${label} <span style="font-size:10px;opacity:.5">(${a.questions.length})</span></span><span class="art-dot"></span>`;
      item.onclick=()=>{startArt(gi,ai);closeSidebar()};al.appendChild(item);
    });
    list.appendChild(al);
  });
}

function masteryKey(gkey,art){return`mastered_D38_${gkey}_${art}`}
function isMastered(gkey,art){return localStorage.getItem(masteryKey(gkey,art))==='1'}
function setMastered(gkey,art,v){if(v)localStorage.setItem(masteryKey(gkey,art),'1');else localStorage.removeItem(masteryKey(gkey,art));buildSidebar()}

let queue=[],idx=0,answered=false,scoreOk=0,scoreKo=0,scoreSkip=0,wrongStreak=0,penaltyDebt=0;
let currentGi=null,currentAi=null,timerInterval=null,timerLeft=60;

function shuffle(arr){const a=[...arr];for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]];}return a}

function beginQuiz(qs,title){
  queue=shuffle(qs);idx=0;scoreOk=0;scoreKo=0;scoreSkip=0;wrongStreak=0;penaltyDebt=0;
  document.getElementById('topbar-title').textContent=title;
  document.getElementById('score-bar').style.display='flex';
  document.getElementById('welcome-screen').style.display='none';
  document.getElementById('results-screen').classList.remove('show');
  document.getElementById('question-area').style.display='block';
  updateScore();showQuestion();
}

function startGrupo(gi){
  currentGi=gi;currentAi=null;
  const g=RAW.grupos[gi];
  const qs=g.arts.filter(a=>!isMastered(g.key,a.art)).flatMap(a=>a.questions);
  if(!qs.length){alert('¡Todos los artículos de este título están marcados como dominados!');return}
  beginQuiz(qs,g.label_full||g.label);
  document.querySelectorAll('.titulo-item').forEach((x,i)=>x.classList.toggle('active',i===gi));
}

function startArt(gi,ai){
  currentGi=gi;currentAi=ai;
  const g=RAW.grupos[gi];const a=g.arts[ai];
  const label=a.art?`Art. ${a.art}`:'Estructura';
  beginQuiz(a.questions,`${g.label} · ${label}`);
  document.querySelectorAll('.titulo-item').forEach((x,i)=>x.classList.toggle('active',i===gi));
  document.querySelectorAll('.art-item').forEach(x=>x.classList.remove('active'));
  const el=document.getElementById(`art-${gi}-${ai}`);if(el)el.classList.add('active');
}

function startFull(){
  currentGi=null;currentAi=null;
  const qs=RAW.grupos.flatMap(g=>g.arts.flatMap(a=>a.questions));
  beginQuiz(qs,'Decreto 38/2020 — Test completo');
}

function showQuestion(){
  stopTimer();if(idx>=queue.length){showResults();return}
  answered=false;const q=queue[idx];
  document.getElementById('q-counter').textContent=`Pregunta ${idx+1} de ${queue.length}`;
  document.getElementById('q-text').textContent=q.q;
  const optDiv=document.getElementById('options');optDiv.innerHTML='';
  ['A','B','C','D'].forEach((L,i)=>{
    const btn=document.createElement('button');btn.className='opt-btn';
    btn.innerHTML=`<span class="opt-letter">${L}</span><span>${q.opts[i]}</span>`;
    btn.onclick=()=>handleAnswer(i,btn,q);optDiv.appendChild(btn);
  });
  document.getElementById('justification').className='';
  document.getElementById('justification').innerHTML='';
  renderActions(false);if(cfg.timer)startTimer();
}

function handleAnswer(chosen,btn,q){
  if(answered)return;answered=true;stopTimer();
  const correct=q.correct;const allBtns=document.querySelectorAll('.opt-btn');
  allBtns.forEach(b=>b.disabled=true);
  if(chosen===correct){btn.classList.add('correct');scoreOk++;wrongStreak=0}
  else{btn.classList.add('wrong');allBtns[correct].classList.add('revealed-correct');scoreKo++;wrongStreak++;if(cfg.penalty&&wrongStreak%3===0)penaltyDebt++}
  if(cfg.justif)showJustif(q.just);updateScore();renderActions(true);
}

function timeOut(q){
  if(answered)return;answered=true;stopTimer();scoreSkip++;
  const allBtns=document.querySelectorAll('.opt-btn');allBtns.forEach(b=>b.disabled=true);
  allBtns[q.correct].classList.add('revealed-correct');
  if(cfg.justif)showJustif(q.just);updateScore();renderActions(true,true);
}

function showJustif(text){
  const j=document.getElementById('justification');
  j.innerHTML=`<strong>Justificación:</strong> ${text}`;j.className='show';
}

function renderActions(hasAnswered,timedOut=false){
  const row=document.getElementById('action-row');row.innerHTML='';
  if(!hasAnswered){
    const skip=document.createElement('button');skip.className='btn btn-ghost';skip.textContent='Omitir →';
    skip.onclick=()=>{stopTimer();scoreSkip++;answered=true;const q=queue[idx];document.querySelectorAll('.opt-btn').forEach(b=>b.disabled=true);document.querySelectorAll('.opt-btn')[q.correct].classList.add('revealed-correct');if(cfg.justif)showJustif(q.just);updateScore();renderActions(true,true)};
    row.appendChild(skip);
  } else {
    const nxt=document.createElement('button');nxt.className='btn btn-primary';
    nxt.textContent=idx+1<queue.length?'Siguiente →':'Ver resultados';
    nxt.onclick=()=>{idx++;showQuestion()};row.appendChild(nxt);
    if(currentAi!==null){
      const g=RAW.grupos[currentGi];const a=g.arts[currentAi];const already=isMastered(g.key,a.art);
      const mBtn=document.createElement('button');mBtn.className=already?'btn btn-danger':'btn btn-success';
      mBtn.textContent=already?'↩ Quitar dominado':'⭐ Marcar dominado';
      mBtn.onclick=()=>{setMastered(g.key,a.art,!already);renderActions(true,timedOut)};row.appendChild(mBtn);
    }
  }
}

function updateScore(){
  const real=Math.max(0,scoreOk-penaltyDebt);const total=queue.length;
  const nota=total>0?((real/total)*10).toFixed(2):'—';
  document.getElementById('sc-ok').textContent=scoreOk;
  document.getElementById('sc-ko').textContent=scoreKo;
  document.getElementById('sc-nota').textContent=nota!=='—'?nota+'/10':'—';
}

function updateTimerDisplay(s){
  const m=Math.floor(s/60),sec=s%60;
  document.getElementById('timer-display').textContent=`${m}:${String(sec).padStart(2,'0')}`;
  const pill=document.getElementById('timer-pill');
  pill.classList.toggle('running',cfg.timer&&s<=60&&s>15);
  pill.classList.toggle('warning',cfg.timer&&s<=15);
}
function startTimer(){if(!cfg.timer)return;timerLeft=60;updateTimerDisplay(timerLeft);timerInterval=setInterval(()=>{timerLeft--;updateTimerDisplay(timerLeft);if(timerLeft<=0){clearInterval(timerInterval);timeOut(queue[idx])}},1000)}
function stopTimer(){clearInterval(timerInterval)}
function toggleTimer(){toggleSetting('timer');document.getElementById('tog-timer').classList.toggle('on',cfg.timer)}

function showResults(){
  stopTimer();document.getElementById('question-area').style.display='none';
  const rs=document.getElementById('results-screen');rs.classList.add('show');
  const real=Math.max(0,scoreOk-penaltyDebt);const total=queue.length;
  const nota=(real/total)*10;const grade=nota.toFixed(2);
  const gradeEl=document.getElementById('res-grade');gradeEl.textContent=grade+'/10';
  gradeEl.className='result-grade '+(nota>=5?'pass':'fail');
  document.getElementById('res-ok').textContent=scoreOk;
  document.getElementById('res-ko').textContent=scoreKo;
  document.getElementById('res-sk').textContent=scoreSkip;
  let meta=`<b>${total}</b> preguntas · Aciertos: <b>${scoreOk}</b>`;
  if(cfg.penalty&&penaltyDebt>0)meta+=` · Penalización: <b>-${penaltyDebt}</b> · Neta: <b>${real}</b>`;
  meta+=`<br>Nota: <b>${grade}/10</b>`;
  document.getElementById('res-meta').innerHTML=meta;
}

function repeatQuiz(){if(currentAi!==null)startArt(currentGi,currentAi);else if(currentGi!==null)startGrupo(currentGi);else startFull()}
function goHome(){
  stopTimer();document.getElementById('results-screen').classList.remove('show');
  document.getElementById('question-area').style.display='none';
  document.getElementById('welcome-screen').style.display='flex';
  document.getElementById('score-bar').style.display='none';
  document.getElementById('topbar-title').textContent='Selecciona un módulo';
}

buildSidebar();
['penalty','timer','justif'].forEach(k=>document.getElementById('tog-'+k).classList.toggle('on',cfg[k]));
updateTimerDisplay(60);
</script>
</body>
</html>
